# 云端请填写实际数据库配置；这些默认值对应原项目的本地配置。
PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=classmatehub
DB_USER=root
DB_PASSWORD=123456
# 也可以提供完整的 go-sql-driver/mysql DSN，优先于以上 DB_* 配置。
# DB_DSN=user:password@tcp(127.0.0.1:3306)/classmatehub?charset=utf8mb4
TZ=Asia/Shanghai
# 单位为秒，与原 Sa-Token 默认有效期一致。
TOKEN_TIMEOUT=2592000
# HTTPS 部署时设置为 true。
COOKIE_SECURE=false
